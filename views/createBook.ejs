<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create a book</title>
    <style>
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;

        /* background: linear-gradient(135deg, #2c3e50 0%, #000000 100%); */
        background-color: rgb(210, 180, 140);
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        flex-direction: column;
        color: white;
      }

      h1 {
        color: white;
        margin-bottom: 10px;
      }

      form {
        background-color: rgb(222, 184, 135);
        margin-top: 460px;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        width: 350px;
        display: flex;
        flex-direction: column;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      h2 {
        margin-bottom: 25px;
        color: #e6ebef;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      input {
        padding: 12px;
        margin-bottom: 15px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 16px;
        outline: none;
        transition: border-color 0.3s;
      }

      input:focus {
        border-color: #ddcdab;
      }

      button {
        background-color: #e0cda4;
        color: rgb(48, 36, 36);
        padding: 12px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s;
        font-weight: bold;
      }

      button:hover {
        background-color: #f1dcad;
      }
    </style>
  </head>
  <body>
    <div class="head">
      <h1>Libraries Club</h1>
      <a href="/home">Home</a>
    </div>
    <h2>Create a Book</h2>
    <form action="/books/create" method="POST">
      <input type="text" name="title" placeholder="Title" required /><br />
      <input
        type="text"
        name="description"
        placeholder="Description"
        required
      />
      <br />

      <input type="text" name="picture" placeholder="Picture" required />
      <br />

      <h4>Genre:</h4>
      <input type="radio" id="fantasy" name="genre" value="Fantasy" />
      <label for="fantasy">Fantasy</label><br />

      <input type="radio" id="romance" name="genre" value="Romance" />
      <label for="romance">Romance</label><br />

      <input type="radio" id="horror" name="genre" value="Horror" />
      <label for="horror">Horror</label><br />

      <input type="radio" id="history" name="genre" value="History" />
      <label for="history">History</label><br />

      <input type="radio" id="crime" name="genre" value="Crime" />
      <label for="crime">Crime</label><br />

      <input type="radio" id="Psychology" name="genre" value="Psychology" />
      <label for="Psychology">Psychology</label><br />
      <br />
      <input
        type="number"
        name="numOfPages"
        placeholder="num Of Pages"
        min="1"
        required
      />
      <br />
      <input type="text" name="author" placeholder="Author" required /><br />
      <input
        type="number"
        name="numOfCopies"
        placeholder="number Of Copies"
        min="1"
        required
      />
      <br />
      <br />
      <button type="submit">Create</button>
    </form>
  </body>
</html>
