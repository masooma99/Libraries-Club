<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= libraryDetails.user.username %></title>
  <style>
    body,html{
        padding: 0;
        margin: 0;
        width: 100%;
        height: 100%;
        /* overflow: hidden; */
        background-color: rgb(210, 180, 140);
      }
    header{
            padding-top: 10px;
            background-color: rgb(222, 184, 135);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding-bottom: 10px;
        }
        .navBar {
            padding: 12px 20px;
            width: 80%;
            background: rgb(210, 180, 140);
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            flex-direction: row;
            gap: 30px;
        }
        .personalInfo{
          display: flex;
          justify-content: flex-start;
          align-items: center;
          gap: 30px;
          padding: 20px;
        }
        .personalInfo img{
          border-radius: 50%;
        }
        .bookList{
        /* position: fixed; */
        top: 0;
        right: 0;
        width: 600px;
        height: 600px;
        /* for the scroll control */
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        /* end of scrolling part */
        /* border: 1px solid black; */
        justify-content: center;
        align-items: center;
      }
        /*
        background-color: rgb(222, 184, 135);   ---->header
        background-color: rgb(210, 180, 140);   ---->body
         */
      .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .book-card {
            background: beige;
            border-radius: 10px;
            overflow: hidden;
            text-align: center;
            width: 200px;
            height: 250px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }

        .book-card:hover {
            transform: translateY(-5px);
        }

        /* .book-card a {  ---> have been removed
            text-decoration: none;
        } */

        .book-image {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .book-title {
            padding: 12px;
        }

        .book-title a {
            color: #333;
            font-weight: bold;
            text-decoration: none;
        }

        .book-title a:hover {
            color: #667eea;
        }
  </style>
</head>
<body>
  <header>
    <h1> Libraries Club</h1>
    <div class="navBar">
      <a href="/users/home">Home</a>
      <% if (libraryDetails.user) { %>
      <a href="/auth/sign-out">sign out</a>
      <div>
        <a href="<%= `/auth/${user._id}/update-password` %>">Update Password</a>
      </div>
    <% } %>
    <!-- I should add else sign in or sign up and instead of the user info it'll just show a message asking the user to sign in  -->
    </div>
  </header>
  <div class="personalInfo">
    <img src="<%=libraryDetails.user.picture%>" alt="Profile Picture">
    <h2><%=libraryDetails.user.username%></h2>
  </div>

  <div class="personalInfo">
    <% if (libraryDetails.user.library === true) { %>
      <a href="/books/create/search">Add Book</a>
    <% } %>
</div>
<hr>

  <div class="books-grid">
    <%for(let i =0; i<libraryDetails.userBooks.length; i++){%>
      <a href="/books/<%=libraryDetails.userBooks[i]._id%>">
        <div class="book-card">
          <% const isUrl = libraryDetails.userBooks[i].picture.startsWith('http') %>
                    <% if (!isUrl) { %>
                        <img src="/images/book.jpg" alt="No image stored in db" class="book-image" height="80px" width="80px">
                    <% } else { %>
                        <img src="<%= libraryDetails.userBooks[i].picture %>" alt="book image" class="book-image" height="80px" width="80px">
                    <% } %>
          <!-- <img src="<%=//libraryDetails.userBooks[i].picture%> " alt="book image" height="80px" width="80px"> -->
          <div class="book-title">
            <h4><%= libraryDetails.userBooks[i].title%></h4>
          </div>
        </div>
      </a>
    <%}%>
    </div>

    <% if (admin) { %>
      <h1>you are an admin <%=admin.user.username%></h1>
      <!-- end of if user is admin -->
    <% } %>
</body>
</html>

