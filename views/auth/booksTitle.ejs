<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <div class="head">
<h1> Libraries Club</h1>
<a href="/home">Home</a>
</div>
    <a href="/users/">Back To Profile Page</a>
    <h2><%= bookReviews.book.title %></h2>
    <p>ID: <%= bookReviews.book._id %></p>
    <img src="<%= bookReviews.book.picture %>" alt="book image" height="80px" width="80px">
    <p>Author: <%= bookReviews.book.author %></p>
    <p>Description: <%= bookReviews.book.description %></p>
    <h2>reviews:</h2>
    <a href="/reviews/<%=bookReviews.book._id%>">Add review</a>

  <%for(let i=0; i<bookReviews.allReviews.length; i++){%>
    <div style="border: 2px solid black;  padding: auto;">
      <!-- user: username, and image -->
       <img src="<%= bookReviews.users[i].picture %>" alt="user profile picture" height="40px" width="40px">
       <p><%=bookReviews.users[i].username%></p>
       <!-- review: rating, and comment -->

          <% let ratingStars = ""
          for(let j =0;j< bookReviews.allReviews[i].rating;i++){
          ratingStars=ratingStars+"⭐"%>
          <%}%>
          <p>Rating:
          <%=//bookReviews.allReviews[j]%>
          <%=ratingStars%>
        </p>
        <p>Comment: <%=//bookReviews.allReviews[j]%></p>
    </div>
    <br>
  <%}%>
</body>
</html>
