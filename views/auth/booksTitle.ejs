<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      body,html{
        padding: 0;
        margin: 0;
        width: 100%;
        height: 100%;
        /* overflow: hidden; */
        background-color: rgb(210, 180, 140);
      }
      header{
        /* background-color: rgb(222, 184, 135);
        display: grid;
        justify-content: center;
        align-items: center;
        grid-auto-flow: column; */
        padding-top: 10px;
            background-color: rgb(222, 184, 135);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding-bottom: 10px;
      }
      /* header h1,a{
        margin-right: 20px;
        /* margin-left: 10px;
      } */
      .bigDiv{
        padding-left: auto;
        padding-right: auto;
        margin: 60px;
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        align-items: center;
        /* grid-template-columns: repeat(2, 1fr); */
      }
      .bookDetails{
        width: 600px;
        /* height: 500px; */
        display: flex;
        flex-direction: column;
        justify-content: center; /* Centers elements horizontally */
        align-items: center;
      }
      .reviewDiv{
        /* position: fixed; */
        top: 0;
        right: 0;
        width: 600px;
        height: 600px;
        /* for the scroll control */
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        /* end of scrolling part */
        /* border: 1px solid black; */
        justify-content: center;
        align-items: center;
      }
      .reviewDiv a, img{
        padding: 20px;
      }
      .comment{
        margin: auto;
        width: 450px;
        border: 2px solid rgb(105, 64, 34);
        display: flex;
        flex-direction: column;
        justify-content: center;
        /* padding: auto; */
      }
      .comment div{
        display: flex;
        flex-direction: row;
        align-items: center;
      }
      .messageComment, .rating{
        margin-left: 20px;
      }
      /* .addReviewLink{
        margin: 20px;
        margin-bottom: 30px;
      } */
      .navBar{
        padding: 12px 20px;
        width: 80%;
        background: rgb(210, 180, 140);
        border: none;
        border-radius: 25px;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 30px;
      }
      .profile_picture{
        border-radius: 50%;
      }
      #rating_div{
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-around;
      }
      #rating{
        display: flex;
        flex-direction: column;
      }
      #deleteEditForms{
        display: flex;
        flex-direction: column;
      }
    </style>
  </head>
  <body>
    <header>
      <h1> Libraries Club</h1>
      <div class="navBar">
        <a href="/users/home">Home</a>
        <a href="/users/<%=user._id%>">Profile</a>
      </div>
    </header>
<div class="bigDiv">

<div class = "bookDetails">
  <h2 class="bookTitle"><%= bookReviews.book.title %></h2>
  <% const isUrl = bookReviews.book.picture.startsWith('http') %>
    <% if (!isUrl) { %>
        <img src="/images/book.jpg" alt="No image stored in db" alt="book image" height="300px" width="300px">
    <% } else { %>
        <img src="<%= bookReviews.book.picture %>" alt="book image" height="300px" width="300px">
    <% } %>
  <!-- <img src="<%= //bookReviews.book.picture %>" alt="book image" height="300px" width="300px"> -->
  <p>Author: <%= bookReviews.book.author %></p>
  <p>Description: <%= bookReviews.book.description %></p>
  <!-- if you want a post method you can't just use a link ... form is the way to do it -->
  <form id="delete-book-form-<%= bookReviews.book._id %>" action="/books/delete/<%= bookReviews.book._id %>?_method=DELETE" method="POST" style="display: inline;">
    <%if(bookReviews.deleteButton){%>
    <button type="submit">Delete Book</button>
    <%}%>
    <br>
  </form>
  <form id="delete-book-form-<%= bookReviews.book._id %>" action="/books/edit/<%= bookReviews.book._id %>?_method=PUT" method="GET" style="display: inline;">
    <%if(bookReviews.deleteButton){%>
    <button type="submit">Edit Book</button>
    <!-- edit book will only edit the number of copies of this book that the libraries signed in account has -->
    <%}%>
    <br>
  </form>
  <h2>You can find this book in these libraries: </h2>
  <%if(bookReviews.libraries){%>
    <!-- not empty ==> print all libraries that has the book -->
     <ul>
     <%for(let i=0;i<bookReviews.libraries.length;i++){%>
      <li><a href="/users/<%=bookReviews.libraries[i].user._id%>"><%=bookReviews.libraries[i].user.username%></a></li>
      <%}%>
      </ul>
    <%}else{%>
      <h4>this book is out of stock</h4>
      <%}%>
  </div>
  <!-- end of bookDetails -->
<br width="20px">
    <div class = "reviewDiv">
      <h2>reviews:</h2>
    <a class="addReviewLink" href="/reviews/<%=bookReviews.book._id%>">Add review</a>
    <br>
  <% if (bookReviews.allReviews.length === 0) { %>
    <p>Be the first to add a review.</p>
  <% } %>

  <% for (let i = 0; i < bookReviews.allReviews.length; i++) { %>
    <div class="comment">
      <div id="reviewer_info">
      <!-- <img src="<%=// bookReviews.users[i].picture %>" alt="user profile picture" height="40px" width="40px"> -->
      <% const isUrl = bookReviews.users[i].picture.startsWith('http') %>
        <% if (!isUrl) { %>
            <img class="profile_picture" src="/images/book.jpg" alt="Profile picture" height="40px" width="40px">
        <% } else { %>
            <img class="profile_picture" src="<%= bookReviews.users[i].picture %>"alt="user profile picture" height="40px" width="40px">
        <% } %>
      <p><strong><%= bookReviews.users[i].username %></strong></p>
      </div>
      <!-- end of reviewer_info -->
      <div id="rating_div">
        <div id="rating">
      <% let ratingStars = "";
        for (let j = 0; j < bookReviews.allReviews[i].rating; j++) {
          ratingStars += "⭐";
        }
      %>
      <p class="rating">Rating: <%= ratingStars %></p>
      </div>
      <div id="deleteEditForms">
      <% if(String(bookReviews.users[i]._id) == String(bookReviews.user._id)){%>
      <!-- start with delete form -->
      <form id="delete-book-form-<%= bookReviews.book._id %>" action="/reviews/delete/<%= bookReviews.allReviews[i]._id %>?_method=DELETE" method="POST" style="display: inline;">
        <br>
        <button type="submit">Delete Review</button>
        <br>
      </form>
      <!-- end of delete form and start of edit form -->
      <form id="edit-review-form-<%= bookReviews.allReviews[i]._id %>" action="/reviews/edit/<%= bookReviews.allReviews[i]._id %>" method="GET" style="display: inline;">
        <br>
        <button type="submit">Edit Review</button>
        <br>
      </form>
      <!-- end of edit form -->
       <%}%>
      </div>
      </div>
      <p class="messageComment">Comment: <%= bookReviews.allReviews[i].comment %></p>

      <!-- end of rating_div -->
    </div>
    <br>
  <% } %>
  </div>
  <!-- end of reviewDiv -->
  </div>
  <!-- end of bigDiv -->
</body>
</html>
