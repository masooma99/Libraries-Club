<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Home Page</title>
     <style>
        .profile {
            padding: 12px 20px;
            width: 80%;
            background: rgb(210, 180, 140);
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            flex-direction: row;
            gap: 30px;
        }
        /*
        background-color: rgb(222, 184, 135);   ---->header
        background-color: rgb(210, 180, 140);   ---->body
         */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: rgb(210, 180, 140);
            /* background: linear-gradient(135deg, #2c3e50 0%, #000000 100%); */
            min-height: 100vh;
            /* padding: 20px; */
        }
        header{
            padding-top: 10px;
            background-color: rgb(222, 184, 135);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }

        h1 {
            text-align: center;
            color: white;
            font-size: 2.5rem;
            margin-bottom: 30px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .search-container {
            text-align: center;
            margin: 20px auto 40px;
            max-width: 500px;
        }

        .search-text {
            width: 70%;
            padding: 12px 20px;
            border: none;
            border-radius: 25px 0 0 25px;
            font-size: 16px;
            outline: none;
        }

        .search-button {
            padding: 12px 25px;
            background: #ff6b6b;
            color: white;
            border: none;
            border-radius: 0 25px 25px 0;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
        }

        .search-button:hover {
            background: #ff5252;
        }

        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .book-card {
            background: beige;
            border-radius: 10px;
            overflow: hidden;
            text-align: center;
            width: 200px;
            height: 250px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }

        .book-card:hover {
            transform: translateY(-5px);
        }

        /* .book-card a {  ---> have been removed
            text-decoration: none;
        } */

        .book-image {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .book-title {
            padding: 12px;
        }

        .book-title a {
            color: #333;
            font-weight: bold;
            text-decoration: none;
        }

        .book-title a:hover {
            color: #667eea;
        }

        .books-grid p {
            grid-column: 1 / -1;
            text-align: center;
            color: white;
            font-size: 1.2rem;
            padding: 40px;
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 1.8rem;
            }

            .books-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 15px;
            }

            .book-image {
                height: 150px;
            }
        }
    </style>
</head>
<body>
<header>
<h1>Libraries Club</h1>
<div class="profile">
<a href="/users/<%=user._id%>">Profile</a>
<a href="#">Libraries</a>
</div>
<br>
</header>
<div class="search-container">
    <form action="/books/search" method="GET">
        <input type="text" name="bookTitle" class="search-text" placeholder="Search " />
        <button type="submit" class="search-button">Search</button>
    </form>
</div>

<div class="books-grid">

        <% books.forEach(book => { %>
            <a href="/books/<%= book._id %>">
                <div class="book-card">
                    <!-- some url images did not show as they are, instead the image in the local storage showed -->
                    <% const isUrl = book.picture.startsWith('http') %>
                    <% if (!isUrl) { %>
                        <img src="/images/book.jpg" alt="No image stored in db" class="book-image" height="80px" width="80px">
                    <% } else { %>
                        <img src="<%= book.picture %>" alt="book image" class="book-image" height="80px" width="80px">
                    <% } %>
                    <div class="book-title">
                        <h4><%= book.title %></h4>
                    </div>
                </div>
            </a>

        <% } ) %>

</div>

</body>
</html>
